# Copy to .env, which git ignores. These values are for your own machine only:
# replace every one of them before running this anywhere else.

# The password of the page. Single sign-on replaces it in production.
APP_PASSWORD=change-me-page
SESSION_SECRET=change-me-session-secret

# One database login per service.
DB_OWNER_PASSWORD=change-me-owner
API_DB_PASSWORD=change-me-api
SYNC_DB_PASSWORD=change-me-sync

# The fake sources stop on 1 November 2026, so the scoring stays on the next Monday.
# Leave this empty with real sources: the scoring then uses the real time.
SCORING_CLOCK=2026-11-02T07:12:00+00:00

# Optional. COOKIE_SECURE must be true as soon as the site uses HTTPS.
WEB_PORT=8080
SYNC_EVERY_MINUTES=60
COOKIE_SECURE=false
