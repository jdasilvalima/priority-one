# Copy to .env and fill in. Never commit .env.
# Full access. Only on your PC, for the script that loads the data.
DATABASE_URL=
# Read-only access. This one goes in the Vercel environment variables.
DATABASE_URL_READONLY=
# Fixed demo clock: every "days ago" is computed from this date.
DEMO_NOW=2026-11-02T07:12:00Z
